# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Reporting Configuration
REPORTING_CURRENCY=USD

# Anomaly Detection Settings
ANOMALY_BASELINE_DAYS=14
ANOMALY_ZSCORE_THRESHOLD=2.0

# Directory Paths (Relative to project root or absolute)
DATA_DIR=data
OUTPUT_DIR=output
PROMPTS_DIR=prompts

# LLM Configuration (Google Gemini default, OpenAI fallback supported)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Slack Notification Settings
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Email / SMTP Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=notifications@example.com
SMTP_TO_EMAIL=marketing-ops@example.com

# Google Ads Integration (Reference configuration parameters)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here

# n8n Admin Credentials (Zero-touch initial setup credentials)
N8N_ADMIN_EMAIL=admin@marketing.local
N8N_ADMIN_PASSWORD=your_n8n_admin_password_here
